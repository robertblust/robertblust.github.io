{
  "name": "blust-ch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "blust.ch — Robert Blust: profile page and talks.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "design": "design sync",
    "design:check": "design sync --check",
    "verify": "node verify/check.mjs",
    "test:og": "node --test verify/og-recipe.test.mjs",
    "pdf": "node export-pdf.mjs",
    "og": "node export-og.mjs",
    "og:check": "node og-check.mjs",
    "principles": "node build/principles.mjs",
    "principles:check": "node build/principles.mjs --check",
    "model": "node build/model.mjs",
    "model:check": "node build/model.mjs --check",
    "dupes": "node tools/dupes.mjs",
    "test:dupes": "node --test tools/dupes.test.mjs",
    "pin:check": "node pin-check.mjs"
  },
  "devDependencies": {
    "@robertblust/design": "github:robertblust/design#v0.19.0",
    "companygraph-meta-model": "github:companygraph/meta-model#v0.10.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1"
  }
}
