# What every member of the family ignores: installed packages, and the state an editor
# or a tool keeps beside the work.
node_modules
.vscode
.claudian
.superpowers

_dbg*
.DS_Store

# generate.py is imported by ad-hoc inspection scripts, which leaves this behind
