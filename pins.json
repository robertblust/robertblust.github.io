{
  "pins": [
    { "kind": "conventions", "file": "conventions.json", "repo": "robertblust/conventions" },
    { "kind": "npm-tag", "file": "package.json", "repo": "robertblust/design", "after": ["npm run design", "npm run og"] },
    { "kind": "npm-tag", "file": "package.json", "repo": "companygraph/meta-model", "after": ["npm run model", "npm run pages", "npm run og"] },
    { "kind": "npm-tag", "file": "package.json", "repo": "companygraph/mcp-server", "after": ["npm run pages", "npm run og"] },
    { "kind": "source-commit", "file": "source.json", "repo": "robertblust/mental-model", "after": ["npm run model", "npm run pages", "npm run og"] }
  ],
  "verify": [
    "./tts/generate.py --dry-run",
    "python3 -m unittest discover -s talks/deciding-well -p 'test_*.py'",
    "npm run test:dupes",
    "npm run test:cost",
    "npm run test:build",
    "npm run pages:check",
    "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} npm run pin:check",
    "npm run design:check",
    "npm run sitemap:check",
    "npm run test:og",
    "npm run og:check",
    "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} npm run model:check",
    "python3 -m http.server 8000 >/dev/null 2>&1 & SERVER_PID=$!; sleep 1; npm run verify && npx design links; STATUS=$?; kill $SERVER_PID; exit $STATUS"
  ]
}
